    "sanity": "6.22.0",
    "styled-components": "6.6.0"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@sanity/cli": "8.27.0",
    "@sanity/eslint-config-studio": "7.0.0",
    "eslint": "10.14.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "26.x"
  }
